# 运行时数据(加密密码/密钥/备份/日志),打包与入库时剔除
data/
# Hermes 本地会话规则(不入库)
.hermes.md
# Python 虚拟环境与本机缓存
.venv/
__pycache__/
*.pyc
# 前端回归测试的本地 jsdom 安装目录
.jsdomtest/
dist/
# API 回归测试的隔离数据目录(运行 tests/test_api.py 时生成)
tests/_api_tmp/
# 测试用的本地依赖目录(无系统 pip 时 --target 安装)
_pydeps/

# 本地 UI 演示(demo 用,不入库)
ui-demo/
# 发版辅助脚本(含本机凭据读取,仅本地用)
scripts/release_v*.py
