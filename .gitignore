# 运行时数据(加密密码/密钥/备份/日志),打包与入库时剔除
data/
# Hermes 本地会话规则(不入库)
.hermes.md
# Python 虚拟环境与本机缓存
.venv/
__pycache__/
*.pyc
# 前端回归测试的本地 jsdom 安装目录
.jsdomtest/
dist/
# Node 依赖(仅开发/CI 用; package.json + package-lock.json 入库, node_modules 不入)
node_modules/
# 回归测试的隔离数据目录(运行 tests/api|unit/e2e 测试时生成)
tests/**/_*_tmp/
# 测试用的本地依赖目录(无系统 pip 时 --target 安装)
_pydeps/
# pip 构建产物(轮子/sdist/egg-info, 由 build_release.py 或 pip 构建生成)
build/
*.egg-info/
# 自带独立运行时(嵌入式 Python/解析缓存,由 install.bat 下载或完整包解出)不入库
runtime/
wheels/
dist/_wheels/
dist/_runtime_cache/

# 本地 UI 演示(demo 用,不入库)
ui-demo/
# 发版辅助脚本(含本机凭据读取,仅本地用)
scripts/release_v*.py
